# ============================================================
# .env.example — Puantaj Takip
# ============================================================
# Bu dosyayı ".env" olarak kopyalayıp gerçek değerlerinizi girin.
# ".env" dosyası .gitignore içinde olduğu için asla commit edilmez.
#
# Veriler Supabase'deki "kv_store" tablosunda saklanır
# (bkz. src/modules/storage.js). Bu iki değişken ZORUNLUDUR.
# Vercel'de: Project -> Settings -> Environment Variables bölümüne
# aynı isimlerle ekleyin ve yeniden deploy edin (VITE_ ile başlayan
# değişkenler build sırasında koda gömülür).
# ------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
